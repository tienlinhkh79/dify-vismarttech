# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Redirect unknown hosts to canonical console domain; allow chatbot + chatbotai.
    if ($is_console_host = 0) {
      return 301 https://${NGINX_SERVER_NAME}$request_uri;
    }
    if ($scheme = http) {
      return 301 https://$host$request_uri;
    }

    set $api_upstream http://api:5001;
    set $web_upstream http://web:3000;
    set $plugin_upstream http://plugin_daemon:5002;
    set $billing_saas_upstream http://billing_saas:8000;

    # 9Pay IPN must hit billing_saas (register public URL: https://<host>/webhooks/9pay/ipn)
    location /webhooks/9pay/ipn {
      proxy_pass $billing_saas_upstream;
      include proxy.conf;
    }

    location /console/api {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    # Legacy omnichannel webhook URLs used /api/triggers/...; API blueprint is /triggers/...
    location /api/triggers/ {
      rewrite ^/api/triggers/(.*)$ /triggers/$1 break;
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /api {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /v1 {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /files {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /explore {
      add_header Set-Cookie "_next_app=web; Path=/; Max-Age=86400; SameSite=Lax" always;
      proxy_pass $web_upstream;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass $plugin_upstream;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    # Console Next chunks must never be served from the landing app (chunk 404 on /omnichannel).
    location ~* ^/_next/.*omnichannel {
      proxy_pass $web_upstream;
      include proxy.conf;
    }

    location ~* ^/_next/.*\(commonLayout\) {
      proxy_pass $web_upstream;
      include proxy.conf;
    }

    # Resolve Next.js static asset conflict between landing and web apps.
    location ^~ /_next/ {
      proxy_pass $next_upstream;
      include proxy.conf;
    }

    # Landing static assets (industry portraits, brand icons).
    location ^~ /industries/ {
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location ^~ /brands/ {
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    # Serve landing page on root without exposing port 3001.
    location = / {
      add_header Set-Cookie "_next_app=landing; Path=/; Max-Age=3600; SameSite=Lax" always;
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    # Serve landing subpages from the same domain root.
    location ^~ /features {
      add_header Set-Cookie "_next_app=landing; Path=/; Max-Age=3600; SameSite=Lax" always;
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location ^~ /pricing {
      add_header Set-Cookie "_next_app=landing; Path=/; Max-Age=3600; SameSite=Lax" always;
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location ^~ /contact {
      add_header Set-Cookie "_next_app=landing; Path=/; Max-Age=3600; SameSite=Lax" always;
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location ^~ /privacy {
      add_header Set-Cookie "_next_app=landing; Path=/; Max-Age=3600; SameSite=Lax" always;
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location ^~ /terms {
      add_header Set-Cookie "_next_app=landing; Path=/; Max-Age=3600; SameSite=Lax" always;
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location = /robots.txt {
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location = /sitemap.xml {
      proxy_pass http://landing:3001;
      include proxy.conf;
    }

    location / {
      add_header Set-Cookie "_next_app=web; Path=/; Max-Age=86400; SameSite=Lax" always;
      proxy_pass $web_upstream;
      include proxy.conf;
    }

    location /mcp {
      proxy_pass $api_upstream;
      include proxy.conf;
    }

    location /triggers {
      proxy_pass $api_upstream;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
