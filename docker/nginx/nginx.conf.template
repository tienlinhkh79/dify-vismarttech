# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

user  nginx;
worker_processes  ${NGINX_WORKER_PROCESSES};

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  ${NGINX_KEEPALIVE_TIMEOUT};

    #gzip  on;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # Console vs landing Next.js both use /_next/. Referer wins over cookie so a stale
    # _next_app=web cookie cannot serve console chunks for landing pages (and vice versa).
    map $http_referer $next_static_from_referer {
        default "";
        ~*"/(apps|explore|omnichannel|mini-crm|datasets|tools|plugins|signin|install|account|activate|reset-password|education-apply)(/|\?|$)" web;
        ~*"/(features|pricing|contact|privacy|terms)(/|\?|$)" landing;
        ~*^https?://[^/]+/?(\?|#|$) landing;
    }

    map $cookie__next_app $next_static_from_cookie {
        default "";
        web web;
        landing landing;
    }

    map $next_static_from_referer $next_static_upstream_resolved {
        default $next_static_from_cookie;
        web web;
        landing landing;
    }

    map $next_static_upstream_resolved $next_upstream {
        default http://web:3000;
        web http://web:3000;
        landing http://landing:3001;
    }

    # Console hostnames (no redirect to canonical — avoids client-router issues on alternate subdomain).
    map $host $is_console_host {
        default 0;
        chatbotai.vismarttech.com 1;
        chatbot.vismarttech.com 1;
    }

    include /etc/nginx/conf.d/*.conf;
}
